<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InsightLab</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-mark"><i class="bi bi-graph-up-arrow"></i></div>
                <div>
                    <div class="brand-name">InsightLab</div>
                    <div class="brand-subtitle">A/B Testing &amp; Statistical Analysis</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-bar-chart-fill"></i> <span>Dashboard</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Experiments" ? "active" : "")"
                   asp-controller="Experiments" asp-action="Index">
                    <i class="bi bi-flask-fill"></i> <span>Experiments</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DataExplorer" ? "active" : "")"
                   asp-controller="DataExplorer" asp-action="Index">
                    <i class="bi bi-table"></i> <span>Data Explorer</span>
                </a>
                <a class="nav-link disabled" href="#" tabindex="-1" title="Coming soon">
                    <i class="bi bi-file-earmark-text-fill"></i> <span>Reports</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-footer-card">
                    <i class="bi bi-lightbulb-fill"></i>
                    <div>
                        <div class="fw-semibold small">Statistical Engine</div>
                        <div class="text-muted-light small">Two-proportion Z-test @@ 95% confidence</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main content -->
        <div class="main-area">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] != null)
                    {
                        <p class="page-subtitle">@ViewData["Subtitle"]</p>
                    }
                </div>
                <div class="topbar-right">
                    <span class="badge-live"><span class="dot"></span> Live Demo Data</span>
                </div>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                InsightLab &mdash; A/B Testing &amp; Statistical Analysis Dashboard &middot; Portfolio project built with ASP.NET Core MVC &amp; EF Core
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
